{
  "name": "fx991ex-classwiz",
  "version": "1.0.0",
  "description": "Casio fx-991EX ClassWiz Scientific Calculator — Full offline emulator",
  "main": "electron/main.js",
  "homepage": "./",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "electron:dev": "concurrently -k \"vite\" \"wait-on http://localhost:5173 && cross-env NODE_ENV=development electron .\"",
    "build:win": "cross-env ELECTRON=true vite build && electron-builder --win --x64",
    "build:linux": "cross-env ELECTRON=true vite build && electron-builder --linux --x64",
    "build:mac": "cross-env ELECTRON=true vite build && electron-builder --mac",
    "build:web": "vite build",
    "build:github": "cross-env VITE_BASE=/fx991ex-calculator/ vite build",
    "cap:add": "npx cap add android",
    "cap:sync": "npm run build:web && npx cap copy android && npx cap sync android",
    "cap:open": "npx cap open android",
    "cap:build": "npm run cap:sync && npx cap open android",
    "predeploy": "npm run build:github",
    "deploy": "gh-pages -d dist"
  },
  "dependencies": {
    "@capacitor/android": "^8.3.1",
    "@capacitor/cli": "^8.3.1",
    "@capacitor/core": "^8.3.1",
    "mathjs": "^12.4.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.2.1",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "electron": "^28.2.0",
    "electron-builder": "^24.9.1",
    "gh-pages": "^6.1.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vite": "^5.2.0",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.fx991ex.classwiz",
    "productName": "fx-991EX ClassWiz",
    "copyright": "MIT — Free educational software",
    "asar": true,
    "directories": {
      "output": "dist-electron",
      "buildResources": "build-resources"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "extraResources": [],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build-resources/icon.ico"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build-resources/icon.png",
      "category": "Education"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "build-resources/icon.icns",
      "category": "public.app-category.education"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
